{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oracle",
  "version": "0.2.0",
  "identifier": "dev.canur.oracle",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "O R A C L E",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#05080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
